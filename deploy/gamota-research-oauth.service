[Unit]
Description=Gamota Research OAuth Authorization Server
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=REPLACE_WITH_SERVICE_USER
Group=REPLACE_WITH_SERVICE_GROUP
WorkingDirectory=REPLACE_WITH_INSTALL_DIRECTORY
EnvironmentFile=/etc/gamota-research-mcp/environment
ExecStart=REPLACE_WITH_INSTALL_DIRECTORY/.venv/bin/python -m gamota_research.oauth_server
Restart=on-failure
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/var/lib/gamota-research-mcp

[Install]
WantedBy=multi-user.target
